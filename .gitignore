# ─────────────────────────────────────────────────────────────────────
# Stock-Agent 통합 저장소 — 루트 .gitignore
#
# 각 하위 프로젝트의 .gitignore 는 원본 그대로 남겨 두었습니다.
# 이 파일은 두 프로젝트가 한 저장소에 들어오면서 필요해진 합집합입니다.
# 규칙이 중복되어도 지우지 않았습니다 — 하위 프로젝트를 단독으로
# 떼어내도 그쪽 .gitignore 만으로 안전해야 하기 때문입니다.
# ─────────────────────────────────────────────────────────────────────

# ── 자격증명 ──────────────────────────────────────────────────────
# 유출되면 재발급 외에는 방법이 없습니다.
.env
.env.*
!.env.example

# ── 대외비 데이터 (stock-monitor) ────────────────────────────────
# 포트폴리오사 실명·회수계획·보유 포지션. 영업비밀·미공개중요정보입니다.
stock-monitor/watchlist.csv
stock-monitor/exit_plan.csv
stock-monitor/positions.csv

# ── 원장 · 산출물 (stock-monitor) ────────────────────────────────
# ki.sqlite 는 87MB 이고 API 로 언제든 다시 만들 수 있습니다.
*.sqlite
*.sqlite-journal
*.parquet
.corp_code_cache.parquet
stock-monitor/out/

# ── 개인 설정 · 매매장부 (trading-floor) ─────────────────────────
# config.json 에는 텔레그램 봇 토큰이 들어갑니다.
trading-floor/config.json
trading-floor/reports/
node_modules/

# ── 통합 계층 ────────────────────────────────────────────────────
# ki-bridge 가 원장을 조회한 결과 캐시 (재생성 가능)
trading-floor/.ki-cache/

# ── 사내 원본 자료 ───────────────────────────────────────────────
*.pptx
*.xlsx
*.hwp

# ── 파이썬 · 주피터 ──────────────────────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# ── OS · 편집기 ──────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── KIS 접근토큰 캐시 ────────────────────────────────────────────
# 자격증명입니다. 하루짜리지만 있는 동안은 그대로 쓸 수 있습니다.
.kis_token.json
.api_verified.json
.papers_candidates.json
.api_verified.tmp

# ── 자동 실행 기록 ──────────────────────────────────────────────
# 실행 로그. 재생성되고, 종목명이 찍힐 수 있습니다.
logs/
