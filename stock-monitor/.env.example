# 이 파일을 .env 로 복사한 뒤 값을 채우십시오.
# .env 는 .gitignore 에 있어 커밋되지 않습니다.

# 한국거래소 데이터 오픈 API (서비스별 URL 사용신청 필요)
KRX_API_KEY=

# 금융감독원 DART 오픈 API
DART_API_KEY=

# 해외 매크로 (선택) — https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# 한국은행 ECOS (선택)
ECOS_API_KEY=

# 한국투자증권 KIS 오픈 API — 실시간 시세 (선택)
# 없으면 원장의 KRX 일별 종가로 돌아갑니다. 주문 API 는 호출하지 않습니다.
KIS_APP_KEY=
KIS_APP_SECRET=

# ── 논문 수확 (선택 — 없어도 전부 돕니다) ────────────────────────────
#
# 넷 다 키 없이 돌아갑니다. 아래는 "더 안정적으로" 돌리기 위한 것입니다.
#
# PAPERS_CONTACT_EMAIL — 키가 아니라 연락처입니다. Crossref 와 OpenAlex 가
#   연락처를 준 쪽을 별도 풀(polite pool)로 보내 줍니다. 신청 절차가 없고
#   이메일만 적으면 됩니다. 가장 먼저 채우십시오.
PAPERS_CONTACT_EMAIL=

# S2_API_KEY — Semantic Scholar. 무료 신청:
#   https://www.semanticscholar.org/product/api#api-key-form
#   키가 없으면 전 세계가 나눠 쓰는 공용 풀이라 429 가 잦습니다.
S2_API_KEY=

# SSRN 은 셀프서비스 API 가 없습니다(Elsevier). 지원팀 문의만 가능하고
# 개인에게 내주는 사례는 드뭅니다. 긁어 오는 것은 이용약관 위반이라 하지
# 않습니다 — 대신 Semantic Scholar 와 OpenAlex 가 색인한 SSRN 프리프린트가
# 함께 들어옵니다.
